# Local overrides for ad-hoc runpod runs.
# Usage:
#   cp env/runpod.local.env.example env/runpod.local.env
#   source env/runpod.local.env

# Installation target
# SPIKYEGGROLL_INSTALL_TARGET='.[cuda13]'

# Optional custom HyperscaleES checkout
# HYPERSCALEES_DIR=/workspace/HyperscaleES

# Common tuning overrides
# POP_SIZE=2048
# RANK=2
# SIGMA=0.01
# LR=0.005
# EPOCHS=100
# BATCH_SIZE=256
# CHUNK_SIZE=512

# Do not store host/port credentials here if you commit this file.
# Use env/runpod.ssh.env (gitignored) for RUNPOD_SSH_* values.
