export PLATFORM_NAME="${PLATFORM_NAME:-runpod}"
export WORKSPACE_ROOT="${WORKSPACE_ROOT:-/workspace}"
export DATA_PATH="${DATA_PATH:-${WORKSPACE_ROOT}/data}"
export LOG_DIR="${LOG_DIR:-${WORKSPACE_ROOT}/logs/spikyeggroll}"
export CHECKPOINT_DIR="${CHECKPOINT_DIR:-${WORKSPACE_ROOT}/checkpoints/spikyeggroll}"
export JAX_COMPILATION_CACHE_DIR="${JAX_COMPILATION_CACHE_DIR:-${WORKSPACE_ROOT}/.jax_cache}"
export XLA_PYTHON_CLIENT_PREALLOCATE="${XLA_PYTHON_CLIENT_PREALLOCATE:-true}"
export XLA_PYTHON_CLIENT_MEM_FRACTION="${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.90}"
export REQUIRE_ACCELERATOR="${REQUIRE_ACCELERATOR:-1}"
export SPIKYEGGROLL_INSTALL_TARGET="${SPIKYEGGROLL_INSTALL_TARGET:-auto}"
